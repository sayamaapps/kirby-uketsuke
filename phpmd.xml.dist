<?xml version="1.0"?>
<ruleset name="Uketsuke"
	xmlns="http://pmd.sf.net/ruleset/1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
	xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
	<description>PHP Mess Detector rules for Uketsuke. Every exclusion and raised threshold has its reason here.</description>

	<rule ref="rulesets/cleancode.xml">
		<!-- The helper classes are static by design, as in Kirby's own code. -->
		<exclude name="StaticAccess" />
		<!-- Public flags such as duplicate and test are part of the value objects. -->
		<exclude name="BooleanArgumentFlag" />
		<!-- Early returns are not enforced; some guards read better with else. -->
		<exclude name="ElseExpression" />
		<!-- Global PHP and Kirby classes are written fully qualified in several places; adding imports is cosmetic. -->
		<exclude name="MissingImport" />
	</rule>

	<rule ref="rulesets/codesize.xml">
		<!-- Purchase is a readonly value object with one field per column of the purchases table (the ledger contract). Splitting it would hide the columns. -->
		<exclude name="TooManyFields" />
		<!-- The limit of 15 public methods is the Regelwerk's maximum; Ledger has one method per ledger operation. -->
		<exclude name="TooManyPublicMethods" />
	</rule>
	<rule ref="rulesets/codesize.xml/TooManyPublicMethods">
		<properties>
			<property name="maxmethods" value="15" />
		</properties>
	</rule>

	<rule ref="rulesets/design.xml/CouplingBetweenObjects">
		<!-- Routes wires the four route handlers to the Kirby app, the ledger, the receiver, the protocol and the retry. Lowering the limit would mean one more route class. -->
		<properties>
			<property name="maximum" value="14" />
		</properties>
	</rule>

	<rule ref="rulesets/naming.xml">
		<!-- Short names are the array keys of the purchase and delivery rows and the loop variables of small helpers. -->
		<exclude name="ShortVariable" />
	</rule>

	<rule ref="rulesets/unusedcode.xml" />
</ruleset>
