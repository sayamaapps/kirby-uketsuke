<?xml version="1.0"?>
<psalm
    errorLevel="3"
    phpVersion="8.2"
    resolveFromConfigFile="true"
    findUnusedBaselineEntry="false"
    findUnusedCode="false"
>
    <projectFiles>
        <directory name="src" />
        <file name="index.php" />
        <file name="autoload.php" />
        <ignoreFiles>
            <directory name="vendor" />
            <directory name="tests" />
            <!-- config/ returns closures that Kirby binds to the app at runtime -->
            <directory name="config" />
        </ignoreFiles>
    </projectFiles>
</psalm>
